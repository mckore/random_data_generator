# Copy this file to .env and adjust as needed. Never commit .env.

# --- Auth ---------------------------------------------------------------
# Required. Sent as X-API-Key on every request except /health.
# Generate with:  openssl rand -hex 32
API_KEY=change-me
# Optional. Sent as X-PII-Reveal-Key together with include_pii=true to render
# tokenized PII back to real values. Leave empty to disable reveal entirely.
# Use a DIFFERENT value from API_KEY and hand it to fewer people.
PII_REVEAL_KEY=

# --- AWS / S3 -----------------------------------------------------------
# AWS credentials are NOT set here - the app container mounts ~/.aws read-only
# and relies on boto3's default credential chain (AWS_PROFILE, env vars, or IAM role).
S3_BUCKET_NAME=jm-dap-dev-landing-o-use1
AWS_REGION=us-east-1
AWS_PROFILE=default
# Server-side encryption applied to every put: AES256 (SSE-S3) or aws:kms.
S3_SSE_MODE=AES256
# Required only when S3_SSE_MODE=aws:kms.
S3_KMS_KEY_ID=

# --- PII ----------------------------------------------------------------
# tokenize (default) | none (raw text everywhere; local debugging only)
PII_MODE=tokenize
# Entity types stored as reversible tokens; everything else detected is redacted.
PII_TOKENIZE_ENTITIES=PERSON,ADDRESS,PHONE_NUMBER

# --- Enrichment providers ----------------------------------------------
# Only "mock" exists today; see README for adding a real vendor.
HOME_VALUE_PROVIDER=mock
OCCUPATION_PROVIDER=mock
